+def load_preserved_pairs(m7, grams) -> tuple[list[PairRecord], list[PairRecord], list[PairRecord]]:
+    """Reconstruct the accepted population from the hash-bound candidate ledger.
+
+    This performs no source draw or admission decision. It verifies the exact
+    accepted-spec cache and, when present, the source ledger from which that
+    cache was derived. Background coefficients/frames are deterministically
+    recomputed from the accepted parameters.
+    """
+    cache_path = RES / "ACCEPTED_SOURCE_SPECS.json"
