+    if not cache_path.exists():
+        raise FileNotFoundError(cache_path)
+    if sha(cache_path) != PRESERVED_ACCEPTED_CACHE_SHA256:
+        raise RuntimeError("accepted source cache hash mismatch")
+    payload = json.loads(cache_path.read_text())
+    if payload.get("source_sha256") != PRESERVED_LEDGER_SHA256:
+        raise RuntimeError("accepted source cache does not name frozen ledger")
+    if ledger_path.exists() and sha(ledger_path) != PRESERVED_LEDGER_SHA256:
+        raise RuntimeError("candidate ledger hash mismatch")
+
+    expected = {
+        ("training", "narrow_hotspot"): TRAIN_PAIRS_PER_FAMILY,
+        ("training", "shearing_spiral"): TRAIN_PAIRS_PER_FAMILY,
+        ("training", "split_merge"): TRAIN_PAIRS_PER_FAMILY,
+        ("validation", "narrow_hotspot"): VAL_PAIRS_PER_FAMILY,
+        ("validation", "shearing_spiral"): VAL_PAIRS_PER_FAMILY,
+        ("validation", "split_merge"): VAL_PAIRS_PER_FAMILY,
+        ("test", "narrow_hotspot"): TEST_PAIRS_PER_FAMILY,
+        ("test", "shearing_spiral"): TEST_PAIRS_PER_FAMILY,
+        ("test", "split_merge"): TEST_PAIRS_PER_FAMILY,
+        ("test", "radial_plume"): TEST_PAIRS_PER_FAMILY,
+    }
+    rows_by_key: dict[tuple[str, str], list[dict[str, Any]]] = {}
+    for row in payload["records"]:
+        key = (str(row["split"]), str(row["family"]))
+        rows_by_key.setdefault(key, []).append(row)
+
+    for key, count in expected.items():
+        rows = sorted(rows_by_key.get(key, []), key=lambda x: int(x["index"]))
+        if len(rows) != count or [int(x["index"]) for x in rows] != list(range(count)):
+            raise RuntimeError(f"preserved population count/index mismatch for {key}")
+        rows_by_key[key] = rows
+    if set(rows_by_key) != set(expected):
+        raise RuntimeError("unexpected split/family in preserved population")
+
+    support_W, _ = load_support()
+
+    def rebuild(split: str, families: Iterable[str]) -> list[PairRecord]:
+        records: list[PairRecord] = []
+        for family in families:
+            for row in rows_by_key[(split, family)]:
+                bg_params = {k: float(v) for k, v in row["background_params"].items()}
+                feature_params = {k: float(v) for k, v in row["feature_params"].items()}
+                c_bg, bg_frames = make_background(m7, grams, str(row["background_family"]), bg_params)
+                fminus = feature_on_eval(family, feature_params, -1)
+                fplus = feature_on_eval(family, feature_params, +1)
+                active = min(
+                    int(np.sum(source_activity(fminus, support_W)[3:] >= 0.03)),
+                    int(np.sum(source_activity(fplus, support_W)[3:] >= 0.03)),
+                )
+                minj = min(
+                    float(np.min(1.0 + bg_frames + fminus)),
+                    float(np.min(1.0 + bg_frames + fplus)),
+                )
+                if active != int(row["active_old_frames"]):
+                    raise RuntimeError(f"preserved activity mismatch for {split}/{family}/{row['index']}")
+                if abs(minj - float(row["minimum_emissivity"])) > 2e-12:
+                    raise RuntimeError(f"preserved positivity mismatch for {split}/{family}/{row['index']}")
+                if minj < 0.0:
+                    raise RuntimeError("preserved source is not positive")
+                records.append(
+                    PairRecord(
+                        split=split,
+                        family=family,
+                        index=int(row["index"]),
+                        background_family=str(row["background_family"]),
+                        background_params=bg_params,
+                        feature_params=feature_params,
+                        c_background=c_bg,
+                        background_frames=bg_frames,
+                    )
+                )
+        return records
+
+    train = rebuild("training", TRAIN_FAMILIES)
+    val = rebuild("validation", TRAIN_FAMILIES)
+    test = rebuild("test", TEST_FAMILIES)
+    if len(train) != 540 or len(val) != 24 or len(test) != 64:
+        raise RuntimeError("preserved population aggregate counts mismatch")
+    return train, val, test
